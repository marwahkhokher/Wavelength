# --- Database ---
DATABASE_URL=postgresql+psycopg2://wavelength:wavelength@db:5432/wavelength

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- LLM (persona generation / evaluation / coach) ---
OPENAI_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini

# --- Storage ---
STORAGE_BACKEND=local          # local | s3
S3_BUCKET=wavelength-audio
S3_REGION=me-central-1

# --- Realtime voice provider (owned by voice-tech-infra, confirm before filling in) ---
VOICE_PROVIDER=openai_realtime  # openai_realtime | elevenlabs | custom
VOICE_PROVIDER_API_KEY=replace-me
