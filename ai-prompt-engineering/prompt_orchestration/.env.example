# Wavelength AI / Prompt Engineering Service Configuration
# Copy this file to .env and fill in your real keys for local development. Never commit .env.

# --- Gemini Conversation LLM ---
GEMINI_API_KEY=
CONVERSATION_MODEL=gemini-2.0-flash
CONVERSATION_TEMPERATURE=0.7
CONVERSATION_MAX_TOKENS=512

# --- ElevenLabs Streaming TTS ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_16000

# --- Provider Mode ---
PROVIDER_MODE=mock

# --- Service Host & Port ---
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=9000
LOG_LEVEL=info

# --- Context Memory ---
MAX_RECENT_TURNS=6
MAX_HISTORY_TURNS_BEFORE_SUMMARY=10
MAX_HISTORY_TOKEN_BUDGET=3000
