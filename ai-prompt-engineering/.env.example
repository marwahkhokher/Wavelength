# Copy these values into the repository-root .env for local development.
# Never commit the real file.

# --- Local self-hosted Qwen (default, free) ---
# 1. Install Ollama: https://ollama.com
# 2. Pull the model:  ollama pull qwen3.5:4b
# 3. Ollama serves an OpenAI-compatible API at this URL automatically.
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_MODEL=qwen3.5:4b
# Not needed for Ollama - leave blank.
QWEN_API_KEY=

# --- OR: Alibaba Model Studio's hosted API (optional, paid) ---
# Uncomment and fill these in instead of the local values above if you'd
# rather use the hosted service.
# DASHSCOPE_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
