# Copy to .env and fill in real keys for local/dev use. Never commit .env.

# --- Deepgram (streaming STT) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US
DEEPGRAM_SAMPLE_RATE=16000
DEEPGRAM_ENCODING=linear16

# --- ElevenLabs (streaming TTS) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_16000

# --- AI service (owned by AI/Prompt Engineering team) ---
# Set to false once the real AI service is reachable at AI_SERVICE_BASE_URL.
USE_MOCK_AI_SERVICE=true
AI_SERVICE_BASE_URL=http://localhost:9000
AI_SERVICE_TIMEOUT_SECONDS=10.0

# --- Session state ---
SESSION_RECONNECT_GRACE_SECONDS=60.0
SESSION_EXPIRY_SWEEP_INTERVAL_SECONDS=15.0

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
